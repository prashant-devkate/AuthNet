@using AuthNet.UI.Models.DTO
@model LoginViewModel

@{
    ViewData["Title"] = "Login";
}

<style>
    body {
        background-color: #fffbea;
        font-family: "Segoe UI", sans-serif;
    }

    .form-label {
        font-weight: 500;
        color: #5a4f3a;
    }

    .form-control {
        font-size: 0.92rem;
        padding: 0.5rem 0.75rem;
        border-radius: 0.5rem;
    }

    .btn-warning {
        background-color: #f0b429;
        border: none;
    }

        .btn-warning:hover {
            background-color: #e0a800;
        }

    .form-text-link {
        font-size: 0.88rem;
        color: #6b7280;
    }

        .form-text-link a {
            text-decoration: none;
            color: #b7791f;
        }

            .form-text-link a:hover {
                text-decoration: underline;
            }

    .card {
        border: none;
        border-radius: 1rem;
        box-shadow: 0 0.15rem 1.75rem rgba(58, 59, 69, 0.15);
    }
</style>

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-12 col-sm-10 col-md-8 col-lg-6 col-xl-5">
            <div class="card bg-white">
                <div class="card-body px-4 py-4">
                    <h5 class="text-center mb-4 text-dark">Login to Your Account</h5>

                    <form asp-action="Login" method="post" novalidate>
                        <div class="mb-3">
                            <label asp-for="Username" class="form-label"></label>
                            <input asp-for="Username" class="form-control" placeholder="Username" />
                            <span asp-validation-for="Username" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Password" class="form-label"></label>
                            <input asp-for="Password" type="password" class="form-control" placeholder="Password" />
                            <span asp-validation-for="Password" class="text-danger small"></span>
                        </div>

                        <button type="submit" class="btn btn-warning w-100 text-white">Login</button>
                    </form>

                    <div class="form-text-link text-center mt-3">
                        Don’t have an account? <a href="/Auth/Register">Register</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
