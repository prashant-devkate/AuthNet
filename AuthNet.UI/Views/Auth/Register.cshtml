@using AuthNet.UI.Models.DTO
@model RegisterViewModel

@{
    ViewData["Title"] = "Register";
}

<style>
    body {
        background-color: #fffbea;
        font-family: "Segoe UI", sans-serif;
    }

    .form-label {
        font-weight: 500;
        color: #5a4f3a;
    }

    .form-control, .form-select {
        font-size: 0.92rem;
        padding: 0.5rem 0.75rem;
        border-radius: 0.5rem;
    }

    .btn-warning {
        background-color: #f0b429;
        border: none;
    }

        .btn-warning:hover {
            background-color: #e0a800;
        }

    .form-text-link {
        font-size: 0.88rem;
        color: #6b7280;
    }

        .form-text-link a {
            text-decoration: none;
            color: #b7791f;
        }

            .form-text-link a:hover {
                text-decoration: underline;
            }

    .card {
        border: none;
        border-radius: 1rem;
        box-shadow: 0 0.15rem 1.75rem rgba(58, 59, 69, 0.15);
    }

    @@media (max-width: 576px) {
        .form-inline .col

    {
        flex: 0 0 100%;
        max-width: 100%;
    }

    }
</style>

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-12 col-sm-10 col-md-8 col-lg-6 col-xl-5">
            <div class="card bg-white">
                <div class="card-body px-4 py-4">
                    <h5 class="text-center mb-4 text-dark">Create Account</h5>

                    <form asp-action="Register" method="post" novalidate>
                        <div class="row g-2 mb-3">
                            <div class="col">
                                <label asp-for="Firstname" class="form-label"></label>
                                <input asp-for="Firstname" class="form-control" placeholder="First name" />
                                <span asp-validation-for="Firstname" class="text-danger small"></span>
                            </div>
                            <div class="col">
                                <label asp-for="Lastname" class="form-label"></label>
                                <input asp-for="Lastname" class="form-control" placeholder="Last name" />
                                <span asp-validation-for="Lastname" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="row g-2 mb-3">
                            <div class="col">
                                <label asp-for="Username" class="form-label"></label>
                                <input asp-for="Username" class="form-control" placeholder="Username" />
                                <span asp-validation-for="Username" class="text-danger small"></span>
                            </div>
                            <div class="col">
                                <label asp-for="Email" class="form-label"></label>
                                <input asp-for="Email" class="form-control" placeholder="Email address" />
                                <span asp-validation-for="Email" class="text-danger small"></span>
                            </div>
                        </div>
                        <div class="row g-3 mb-3">
                            <div class="col-md-6">
                                <label asp-for="Role" class="form-label d-block">Role</label>
                                <select asp-for="Role" class="form-select">
                                    <option value="">Select Role</option>
                                    <option>Admin</option>
                                    <option>User</option>
                                </select>
                                <span asp-validation-for="Role" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="Password" class="form-label d-block">Password</label>
                                <input asp-for="Password" type="password" class="form-control" placeholder="Password" />
                                <span asp-validation-for="Password" class="text-danger small"></span>
                            </div>
                        </div>




                        <button type="submit" class="btn btn-warning w-100 text-white">Register</button>
                    </form>

                    <div class="form-text-link text-center mt-3">
                        Already have an account? <a href="/Auth/Login">Login</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
