@model AuthNet.UI.Models.DTO.ForecastViewModel

@{
    ViewData["Title"] = "Forecast";
}

<link href="https://cdn.jsdelivr.net/npm/tailwindcss@2.2.19/dist/tailwind.min.css" rel="stylesheet">

<div class="container mx-auto p-4 max-w-3xl">
    <h2 class="text-xl font-semibold text-gray-800 mb-4">Product Forecast</h2>

    <div class="bg-white shadow-sm rounded-lg p-5">
        <form asp-action="Index" method="get" class="mb-5">
            <div class="flex items-center space-x-3">
                <label for="productId" class="text-sm font-medium text-gray-600">Product</label>
                <select asp-for="ProductId" asp-items="ViewBag.Products"
                        class="block w-48 px-2 py-1.5 border border-gray-300 rounded-md
                               focus:outline-none focus:ring-blue-500 focus:border-blue-500
                               text-sm"
                        onchange="this.form.submit()">
                    <option value="">-- Select Product --</option>
                </select>
            </div>
        </form>

        <div class="w-full" style="height: 300px;">
            <canvas id="forecastChart"></canvas>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        var historyLabels = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(
                    Model.History.Series.Select(s => s.Date.ToString("yyyy-MM-dd"))
            ));

    var historyData = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(
                Model.History.Series.Select(s => s.Quantity)
        ));

    // Filter to show only the last 7 days of history
    var last7DaysIndex = Math.max(0, historyLabels.length - 7);
    historyLabels = historyLabels.slice(last7DaysIndex);
    historyData = historyData.slice(last7DaysIndex);

        var forecastLabels = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(
                Model.Forecast.Select(f => f.Date.ToString("yyyy-MM-dd"))
        ));

    var forecastData = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(
                Model.Forecast.Select(f => f.PredictedQty)
        ));

    var labels = historyLabels.concat(forecastLabels);

        var ctx = document.getElementById('forecastChart').getContext('2d');
        var chart = new Chart(ctx, {
            type: 'line',
            data: {
                labels: labels,
                datasets: [
                    {
                        label: 'History',
                        data: historyData,
                        borderColor: '#2563EB',
                        backgroundColor: 'rgba(37, 99, 235, 0.1)',
                        fill: true,
                        tension: 0.3,
                        pointRadius: 2
                    },
                    {
                        label: 'Forecast',
                        data: Array(historyLabels.length).fill(null).concat(forecastData),
                        borderColor: '#F59E0B',
                        backgroundColor: 'rgba(245, 158, 11, 0.1)',
                        fill: true,
                        tension: 0.3,
                        pointRadius: 2,
                        borderDash: [4, 4]
                    }
                ]
            },
            options: {
                responsive: true,
                maintainAspectRatio: true,
                aspectRatio: 2.5,
                plugins: {
                    legend: {
                        position: 'top',
                        labels: {
                            font: { size: 11 },
                            padding: 10
                        }
                    },
                    tooltip: {
                        backgroundColor: 'rgba(0,0,0,0.7)',
                        titleFont: { size: 12 },
                        bodyFont: { size: 11 }
                    }
                },
                scales: {
                    x: {
                        grid: { display: false },
                        title: {
                            display: true,
                            text: 'Date',
                            font: { size: 12 }
                        }
                    },
                    y: {
                        grid: { borderDash: [2, 2] },
                        title: {
                            display: true,
                            text: 'Quantity',
                            font: { size: 12 }
                        }
                    }
                }
            }
        });
    </script>
}