@using AuthNet.UI.Models.DTO
@model IEnumerable<AuthNet.UI.Models.DTO.PurchaseOrderDto>
@{
    ViewData["Title"] = "Purchase Orders";
}

<!-- Custom CSS for Symbols -->
<style>
    .badge-order-status {
        font-size: 1.2rem;
    }

    .status-pending {
        color: #ffc107; /* Yellow */
    }

    .status-delivered {
        color: #28a745; /* Green */
    }
</style>

<!-- Page Heading -->
<div class="d-sm-flex align-items-center justify-content-between mb-4">
    <h1 class="h3 mb-0 text-gray-800"><i class="fas fa-bag-check me-2"></i> Purchase Orders</h1>
    <a asp-controller="PurchaseOrders" asp-action="Add" class="d-none d-sm-inline-block btn btn-primary btn-icon-split btn-sm shadow-sm">
        <span class="icon text-white-50">
            <i class="fas fa-plus-circle"></i>
        </span>
        <span class="text">Add Purchase Order</span>
    </a>
</div>

<!-- Content Row -->
<div class="row">
    <div class="col-12">
        <div class="card shadow mb-4">
            <div class="card-header py-3 d-flex justify-content-between align-items-center">
                <h6 class="m-0 font-weight-bold text-primary">Purchase Orders List</h6>
                <button type="button" class="btn btn-info btn-icon-split btn-sm shadow-sm" data-bs-toggle="modal" data-bs-target="#helpModal">
                    <span class="icon text-white-50">
                        <i class="fas fa-question-circle"></i>
                    </span>
                </button>
            </div>
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-bordered table-hover" id="dataTable" width="100%" cellspacing="0">
                        <thead>
                            <tr>
                                <th>Supplier</th>
                                <th>Salesman</th>
                                <th>Order Date</th>
                                <th>Total Amount</th>
                                <th>Status</th>
                                <th class="text-center">Actions</th>
                            </tr>
                        </thead>
                        <tfoot>
                            <tr>
                                <th>Supplier</th>
                                <th>Salesman</th>
                                <th>Order Date</th>
                                <th>Total Amount</th>
                                <th>Status</th>
                                <th class="text-center">Actions</th>
                            </tr>
                        </tfoot>
                        <tbody>
                            @if (Model != null && Model.Any())
                            {
                                @foreach (var order in Model)
                                {
                                    <tr>
                                        <td class="fw-semibold">@order.Suppliername</td>
                                        <td class="text-muted">@order.Username</td>
                                        <td class="text-muted">@order.OrderDate.ToString("yyyy-MM-dd HH:mm")</td>
                                        <td class="fw-semibold">₹ @order.TotalAmount</td>
                                        <td class="small badge-order-status @(order.IsDelivered == DeliveryStatus.Delivered ? "status-delivered" : "status-pending")">
                                            @(order.IsDelivered == DeliveryStatus.Delivered ? "✅" : "⚠️")
                                        </td>
                                        <td class="text-center">
                                            <form asp-action="UpdateStatus" method="post" class="d-inline"
                                                  onsubmit="return confirm('Update the status?');">
                                                <input type="hidden" name="id" value="@order.PurchaseOrderId" />
                                                <input type="hidden" name="isDelivered" value="@(order.IsDelivered == DeliveryStatus.Delivered ? 0 : 1)" />
                                                <button type="submit" class="btn btn-primary btn-icon-split btn-sm">
                                                    <span class="icon text-white-50">
                                                        <i class="fas fa-toggle-on"></i>
                                                    </span>
                                                </button>
                                            </form>
                                            <a asp-action="Edit" asp-route-id="@order.PurchaseOrderId" class="btn btn-warning btn-icon-split btn-sm me-1">
                                                <span class="icon text-white-50">
                                                    <i class="fas fa-pencil-alt"></i>
                                                </span>
                                            </a>
                                            <form asp-action="Delete" asp-route-id="@order.PurchaseOrderId"
                                                  method="post" class="d-inline"
                                                  onsubmit="return confirm('Delete this order?');">
                                                <button class="btn btn-danger btn-icon-split btn-sm">
                                                    <span class="icon text-white-50">
                                                        <i class="fas fa-trash"></i>
                                                    </span>
                                                </button>
                                            </form>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="5" class="text-center text-muted py-4">
                                        <i class="fas fa-info-circle me-2"></i>No purchase orders found.
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Help Modal -->
<div class="modal fade" id="helpModal" tabindex="-1" aria-labelledby="helpModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="helpModalLabel">Help - Action Buttons</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <ul class="list-group">
                    <li class="list-group-item"><strong>Update Status Button:</strong> Toggles the delivery status of the purchase order between Pending (⚠️) and Delivered (✅).</li>
                    <li class="list-group-item"><strong>Edit Button:</strong> Allows you to edit the details of the purchase order.</li>
                    <li class="list-group-item"><strong>Delete Button:</strong> Deletes the purchase order permanently (requires confirmation).</li>
                </ul>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        $(document).ready(function () {
            $('#dataTable').DataTable({
                "paging": true,
                "searching": true,
                "ordering": true,
                "info": true,
                "columnDefs": [
                    { "orderable": false, "targets": [5, 6] } // Disable sorting on Toggle Status and Actions
                ]
            });
        });
    </script>
}