@model AuthNet.UI.Models.DTO.SalesListViewModel

<style>
    /* --- Print-friendly styling --- */
    @@media print {
        body *

    {
        visibility: hidden;
    }

    #print-section, #print-section * {
        visibility: visible;
    }

    #print-section {
        position: absolute;
        left: 0;
        top: 0;
        width: 100%;
    }

    /* Hide print button and pagination when printing */
    #print-btn, .pagination-container {
        display: none !important;
    }

    }

    /* --- Page Styling --- */
    table.report-table th, table.report-table td {
        border: 1px solid #dee2e6 !important;
        vertical-align: middle;
        padding: 4px 6px !important;
    }

    table.report-table th {
        background-color: #f8f9fa;
        font-weight: 600;
    }

    table.report-table {
        border-collapse: collapse !important;
        width: 100%;
        font-size: 13px;
    }

    .day-header {
        background: #f1f3f5;
        font-weight: 600;
        padding: 4px 8px;
        border-left: 4px solid #0d6efd;
        margin-top: 1rem;
    }

    .text-success {
        color: #198754 !important;
    }
</style>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="text-primary fw-bold mb-0">
        <i class="bi bi-calendar-event me-2"></i> Daily Sales Report
    </h4>
    <button id="print-btn" class="btn btn-outline-primary btn-sm" onclick="printSalesRecords()">
        <i class="bi bi-printer me-1"></i> Export as Pdf
    </button>
</div>

<div id="print-section">
    @foreach (var day in Model.Sales)
    {
        <div class="mb-2">
            <div class="day-header">
                Total Sales: ₹@day.TotalSales | Invoices: @day.InvoiceCount
            </div>

            <table class="table table-sm report-table mt-2 mb-4">
                <thead>
                    <tr>
                        <th>Invoice No</th>
                        <th>Date</th>
                        <th>Customer</th>
                        <th>Mobile</th>
                        <th>Address</th>
                        <th>Product</th>
                        <th class="text-center">Qty</th>
                        <th class="text-end">Unit Price</th>
                        <th class="text-end">Total</th>
                        <th class="text-end">Invoice Total</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var sale in day.Sales)
                    {
                        var itemCount = sale.Items.Count();
                        var firstItem = true;

                        @foreach (var item in sale.Items)
                        {
                            <tr>
                                @if (firstItem)
                                {
                                    <td rowspan="@itemCount">@sale.InvoiceNo</td>
                                    <td rowspan="@itemCount">@sale.InvoiceDate.ToString("dd-MMM-yyyy HH:mm")</td>
                                    <td rowspan="@itemCount">@sale.Customername</td>
                                    <td rowspan="@itemCount">@sale.PhoneNumber</td>
                                    <td rowspan="@itemCount">@sale.Address</td>
                                    firstItem = false;
                                }

                                <td>@item.ProductName</td>
                                <td class="text-center">@item.Quantity</td>
                                <td class="text-end">₹@item.UnitPrice</td>
                                <td class="text-end">₹@item.TotalPrice</td>

                                @if (item == sale.Items.Last())
                                {
                                    <td rowspan="@itemCount" class="text-end fw-semibold text-success align-middle">
                                        ₹@sale.TotalAmount
                                    </td>
                                }
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@if (Model.TotalPages > 1)
{
    <div class="text-center mt-3 pagination-container">
        @for (int i = 1; i <= Model.TotalPages; i++)
        {
            if (i == Model.CurrentPage)
            {
                <span class="fw-bold mx-1">[@i]</span>
            }
            else
            {
                <a asp-action="DailySalesReport" asp-route-page="@i" class="text-decoration-none mx-1">@i</a>
            }
        }
    </div>
}

    <script>
    function printSalesRecords() {
        // Show loading message (optional)
        const btn = document.getElementById('print-btn');
        btn.disabled = true;
        btn.innerHTML = '<i class="bi bi-hourglass-split me-1"></i> Generating...';

        // Trigger download
        fetch('/Sales/GenerateSalesReportPdf')
            .then(response => {
                if (!response.ok) throw new Error('Failed to generate PDF');
                return response.blob();
            })
            .then(blob => {
                const url = window.URL.createObjectURL(blob);
                const a = document.createElement('a');
                const today = new Date().toLocaleDateString('en-GB')
                    .replace(/\//g, '-'); // dd-MM-yyyy format
                a.href = url;
                a.download = `Dailysalesreport-${today}.pdf`;
                document.body.appendChild(a);
                a.click();
                a.remove();
                window.URL.revokeObjectURL(url);
            })
            .catch(err => alert('Error: ' + err.message))
            .finally(() => {
                // Reset button
                btn.disabled = false;
                btn.innerHTML = '<i class="bi bi-printer me-1"></i> Export as Pdf';
            });
    }
</script>