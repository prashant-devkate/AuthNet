@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Welcome - InventoryPro</title>

    <!-- Bootstrap + Font Awesome -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet" />

    <style>
        body, html {
            margin: 0;
            height: 100%;
            font-family: "Segoe UI", sans-serif;
            background-color: #fffbea;
        }

        .welcome-container {
            display: flex;
            height: 100vh;
        }

        .left-panel {
            flex: 1;
            display: flex;
            justify-content: center;
            align-items: center;
            background-color: #fffef2;
        }

        .right-panel {
            flex: 1;
            background: linear-gradient(135deg, #fff3cd, #ffeeba);
            color: #5a4f3a;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 40px;
        }

            .right-panel h1 {
                font-size: 2.5rem;
                font-weight: 600;
            }

        .card {
            border: none;
            border-radius: 0.75rem;
            box-shadow: 0 0.15rem 1.75rem rgba(58, 59, 69, 0.15);
            padding: 30px;
            max-width: 400px;
            width: 100%;
            background-color: #ffffff;
        }

        .btn {
            min-width: 130px;
        }

        @@media (max-width: 768px) {
            .welcome-container

        {
            flex-direction: column;
        }

        .right-panel {
            height: 220px;
            text-align: center;
        }

        }
    </style>
</head>
<body>

    <div class="welcome-container">
        <!-- Left Panel: Login/Register -->
        <div class="left-panel">
            <div class="card text-center">
                <h2 class="h4 text-dark mb-3">Welcome to <strong>InventoryPro</strong></h2>
                <p class="text-muted mb-4">Please login or register to continue.</p>
                <div class="d-grid gap-2 d-sm-flex justify-content-sm-center">
                    <a class="btn btn-warning text-white me-2" href="@Url.Action("Login", "Auth")">
                        <i class="fas fa-sign-in-alt me-1"></i> Login
                    </a>
                    <a class="btn btn-outline-warning" href="@Url.Action("Register", "Auth")">
                        <i class="fas fa-user-plus me-1"></i> Register
                    </a>
                </div>
            </div>
        </div>

        <!-- Right Panel: Branding -->
        <div class="right-panel">
            <div>
                <h1>InventoryPro</h1>
                <p class="lead">Organize. Simplify. Grow.</p>
            </div>
        </div>
    </div>

</body>
</html>
