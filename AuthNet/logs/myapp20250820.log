SELECT [t].[Key] AS [Day], COALESCE(SUM([t].[Quantity]), 0) AS [Qty]
FROM (
    SELECT [s].[Quantity], CONVERT(date, [s0].[InvoiceDate]) AS [Key]
    FROM [SaleItems] AS [s]
    INNER JOIN [Sales] AS [s0] ON [s].[SaleId] = [s0].[Id]
    WHERE [s].[ProductId] = @__productId_0 AND [s0].[InvoiceDate] >= @__start_1 AND [s0].[InvoiceDate] <= @__end_2
